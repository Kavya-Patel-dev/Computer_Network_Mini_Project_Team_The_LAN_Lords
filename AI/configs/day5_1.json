{
  "architecture": {
    "encoder": "GATv2",
    "layers": 2,
    "heads": 4,
    "channels_per_head": 16,
    "edge_features": 5,
    "optional_third_layer": false,
    "path_pooling": "learned_attention"
  },
  "learning_rate": 0.0005,
  "gamma": 0.95,
  "loss": "Huber",
  "gradient_clip_norm": 10.0,
  "soft_target_tau": 0.005,
  "batch_size": 64,
  "replay_capacity": 25000,
  "learning_starts": 2000,
  "epsilon_start": 1.0,
  "epsilon_end": 0.05,
  "epsilon_fraction": 0.30,
  "update_every": 4,
  "reward_clip": [-5.0, 2.0],
  "train_episode_steps": 500,
  "stage_a_steps": 30000,
  "stage_a_quick_steps": 5000,
  "stage_b_steps": 300000,
  "stage_b_quick_steps": 20000,
  "stage_c_steps": 1000000,
  "stage_b_evaluation_interval": 25000,
  "stage_b_validation_seeds": [30000, 30001],
  "stage_b_checkpoint_selection_split": "val",
  "training_intensity_distribution": {
    "kind": "log_uniform",
    "minimum": 0.01,
    "maximum": 0.30
  },
  "stage_b_top_checkpoints": 3,
  "stage_a_graph": "abilene",
  "stage_a_generator": "poisson",
  "stage_a_seeds": [20000, 20001],
  "stage_a_intensity_from_eval_config": true,
  "store_tensor_replay": true,
  "use_custom_collate": true,
  "reuse_duplicate_states": true
}
